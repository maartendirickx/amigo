# AMiGO inlist, created with `amigo init` (amigo.compute_rotation.init_inlist).
# The numerical settings are the AMiGO defaults. All other values are examples:
# adapt them to the analysed star.

&observations
    starname = 'STARNAME'                        # string: star name, with "_"-characters replacing any spaces in the name
    patterns = 'PATTERN_FILENAME'                # string: path to the file with detected period spacings. The required formatting is described in the documentation.
/


&modes                                           # possible mode identifications for the (first) observed pattern
    k = 0                                        # integers: meridional degrees k of the calculated asymptotic models
    m = 1                                        # integers: the (corresponding) azimuthal orders m of the calculated asymptotic models
/


&numerical
    optimisation_method = {optimisation_method!r:<23}# string: method used to sample and evaluate the parameter space ('grid', 'iterative' or 'lmfit')
    diagnostic = {diagnostic!r:<32}# string: which diagnostic is used to evaluate the observed period-spacing patterns ('spacings' or 'frequency')
    use_sequence = {use_sequence!r:<30}# boolean: do we have enough information to fill gaps in the observed pattern(s), if any? Only used when diagnostic is 'frequency'.
    sigma_sampling = {sigma_sampling!r:<28}# Only used when optimisation_method is 'iterative'. Minimum number of projected data points that is calculated per 1-sigma error margin.
    grid_scaling = {grid_scaling!r:<30}# Only used when optimisation_method is 'iterative'. scaling factor for the required grid size at each iteration. 
                                                 # At each step, the grid is centered around the current best solution, with parameter X ranges given by: 2 * sigma_sampling * grid_scaling * dX,
                                                 # where dX is the current step size for the parameter X in the grid.
    cvg_rate = {cvg_rate!r:<34}# Convergence rate of the grid during the iteration, only used when optimisation_method is 'iterative'. 
                                                 # At each iteration, the parameter step size dX in the grid is decreased by this factor.
/


&star
    Pi0 = 2300.0  5600.0  100.0                  # floats: minimum, maximum and step of the evaluated buoyancy travel times (in seconds)
/


&rotation
    frot = 0.0  2.5  0.005                       # floats: minimum, maximum and step of the evaluated rotation rates (in cycle per day)
/


&output
    interactive = False                          # boolean: show the output as a Matplotlib figure rather than just saving it
    output_dir = '.'                             # string: path to the directory in which the results will be saved (in a subdirectory <OUTPUT_DIR>/<STARNAME>/)
/
